<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Game view per game (ui/GameViewPicker) lists installed games: Android 11+ hides other apps without this.
         RM Tweaks is installed outside the Play Store, so the Play policy for this permission does not apply. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="cn.nubia.gameassist" />
        <package android:name="cn.nubia.gamelauncher" />
        <package android:name="cn.nubia.gamehelpmodule" />
        <package android:name="cn.nubia.gamelab" />
        <package android:name="cn.nubia.gamehighlights" />
        <package android:name="com.zte.beautify" />
        <package android:name="com.zte.fingerprints" />
        <package android:name="com.fingerprint.sensorservice" />
        <package android:name="com.zte.mifavor.launcher" />
        <package android:name="com.android.systemui" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.zte.zgesture" />
        <package android:name="com.zte.powersavemode" />
        <package android:name="cn.nubia.keymapcenter" />
        <package android:name="cn.nubia.colorfullight" />
        <package android:name="com.zte.heartyservice" />
        <package android:name="cn.nubia.game.magicvoice" />
        <package android:name="cn.nubia.touping" />
        <package android:name="com.android.nfc" />
        <package android:name="com.zte.cn.doubleapp" />
        <!-- icon packs for the stock launcher (ui/IconPackPicker) -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.fede.launcher.THEME_ICONPACK" /></intent>
        <intent><action android:name="com.dlto.atom.launcher.THEME" /></intent>
        <intent><action android:name="com.actionlauncher.playstore.ICONPACK" /></intent>
        <intent><action android:name="ginlemon.smartlauncher.THEMES" /></intent>
        <intent><action android:name="com.lge.launcher2.THEME" /></intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RedMagicTweaks">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_description" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <meta-data android:name="xposedsharedprefs" android:value="true" />

        <provider
            android:name=".LogProvider"
            android:authorities="${applicationId}.log"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- the log as a .txt file for the share sheet (ui/LogActivity) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- the lock screen video clip, read-only, for System UI (xposed/LockVideoHooks) -->
        <provider
            android:name=".LockVideoProvider"
            android:authorities="${applicationId}.lockvideo"
            android:exported="true"
            android:grantUriPermissions="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.CategoryActivity" android:exported="false" />
        <activity android:name=".ui.AboutActivity" android:exported="false" />
        <activity android:name=".ui.FirstRunActivity" android:exported="false" />
        <activity android:name=".ui.LogActivity" android:exported="false" />
        <!-- lock screen video: picked in the app, or handed over by a gallery (Set as… / Share) -->
        <activity android:name=".ui.LockVideoActivity" android:exported="true" android:label="Lock screen video">
            <intent-filter android:label="Lock screen video">
                <action android:name="android.intent.action.ATTACH_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:label="Lock screen video">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".SafeModeTile"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="Safe mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
    </application>
</manifest>
