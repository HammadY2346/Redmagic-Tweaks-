<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="cn.nubia.gameassist" />
        <package android:name="cn.nubia.gamelauncher" />
        <package android:name="cn.nubia.gamehelpmodule" />
        <package android:name="cn.nubia.gamelab" />
        <package android:name="cn.nubia.gamehighlights" />
        <package android:name="com.zte.beautify" />
        <package android:name="com.zte.fingerprints" />
        <package android:name="com.fingerprint.sensorservice" />
        <package android:name="com.zte.mifavor.launcher" />
        <package android:name="com.android.systemui" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.zte.zgesture" />
        <package android:name="com.zte.powersavemode" />
        <package android:name="cn.nubia.keymapcenter" />
        <package android:name="cn.nubia.colorfullight" />
        <package android:name="com.zte.heartyservice" />
        <package android:name="cn.nubia.game.magicvoice" />
        <package android:name="cn.nubia.touping" />
        <package android:name="com.android.nfc" />
        <package android:name="com.zte.cn.doubleapp" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RedMagicTweaks">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_description" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <meta-data android:name="xposedsharedprefs" android:value="true" />

        <provider
            android:name=".LogProvider"
            android:authorities="${applicationId}.log"
            android:exported="true"
            android:grantUriPermissions="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.SectionActivity" android:exported="false" />
        <activity android:name=".ui.LogActivity" android:exported="false" />
        <activity android:name=".ui.PickerActivity" android:exported="false" />
    </application>
</manifest>
