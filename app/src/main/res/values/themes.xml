<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RedMagicTweaks" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryContainer">@color/accent_dim</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_hi</item>
        <item name="colorSurfaceVariant">@color/surface_hi</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.RedMagicTweaks.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RedMagicTweaks.Dialog</item>
    </style>

    <style name="ThemeOverlay.RedMagicTweaks.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.RedMagicTweaks.BottomSheet</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>
    <style name="Widget.RedMagicTweaks.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/Shape.RedMagicTweaks.Sheet</item>
    </style>
    <style name="Shape.RedMagicTweaks.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ThemeOverlay.RedMagicTweaks.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.RedMagicTweaks.Dialog</item>
    </style>
    <style name="Shape.RedMagicTweaks.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- One UI style large title of the collapsing app bar -->
    <style name="TextAppearance.RedMagicTweaks.LargeTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">34sp</item>
    </style>
    <style name="TextAppearance.RedMagicTweaks.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
