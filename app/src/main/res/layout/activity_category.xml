<?xml version="1.0" encoding="utf-8"?>
<!-- Category page: large title, a slim pinned preview strip once the big preview has scrolled away, grouped rows. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:background="@color/bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bg" app:liftOnScroll="false" android:stateListAnimator="@null">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_width="match_parent" android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            android:background="@color/bg" app:contentScrim="@color/bg"
            app:expandedTitleTextAppearance="@style/TextAppearance.RedMagicTweaks.LargeTitle"
            app:collapsedTitleTextAppearance="@style/TextAppearance.RedMagicTweaks.Title"
            app:expandedTitleMarginStart="24dp"
            app:maxLines="2"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent" android:elevation="0dp"
                app:navigationIcon="@drawable/ic_back"
                app:layout_collapseMode="pin" app:menu="@menu/category_menu" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
        <ImageView
            android:id="@+id/strip"
            android:layout_width="match_parent" android:layout_height="64dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp"
            android:scaleType="fitCenter" android:visibility="gone"
            android:contentDescription="Preview, tap to scroll up" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="112dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <include layout="@layout/view_restart_bar" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
