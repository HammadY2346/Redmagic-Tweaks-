<?xml version="1.0" encoding="utf-8"?>
<!-- The one pending-restart bar: what is waiting and the action that applies it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/restart_bar"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp"
    android:background="@drawable/restart_bar_bg" android:elevation="6dp"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="18dp" android:paddingTop="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp"
    android:visibility="gone">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_restart"
        android:layout_marginEnd="12dp" android:contentDescription="@null" />
    <TextView android:id="@+id/restart_text" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" android:maxLines="2"
        android:ellipsize="end" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/restart_secondary"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="0dp" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/restart_action"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="0dp" app:cornerRadius="20dp" />
</LinearLayout>
