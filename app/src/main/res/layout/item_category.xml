<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cat"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="4dp" android:background="@drawable/card_bg" android:foreground="?attr/selectableItemBackground"
    android:minHeight="128dp" android:orientation="vertical" android:padding="16dp">
    <ImageView android:id="@+id/cat_icon" android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/icon_circle" android:padding="10dp" android:contentDescription="@null" />
    <TextView android:id="@+id/cat_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:maxLines="2" android:textColor="@color/text" android:textSize="15.5sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/cat_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="@color/text_dim" android:textSize="12.5sp" android:textStyle="bold" />
    <TextView android:id="@+id/cat_contents" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:lineSpacingExtra="1dp" android:maxLines="4"
        android:textColor="@color/text_dim" android:textSize="11.5sp" />
</LinearLayout>
