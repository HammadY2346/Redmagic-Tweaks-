<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/opt"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground" android:gravity="center_vertical"
    android:minHeight="52dp" android:orientation="horizontal" android:paddingStart="24dp" android:paddingEnd="20dp">
    <TextView android:id="@+id/opt_text" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp"
        android:textColor="@color/text" android:textSize="16sp" />
    <ImageView android:id="@+id/opt_check" android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_check" android:visibility="invisible" android:contentDescription="Selected" />
</LinearLayout>
