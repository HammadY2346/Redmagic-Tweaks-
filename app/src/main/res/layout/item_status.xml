<?xml version="1.0" encoding="utf-8"?>
<!-- Home status card: module state, phone, root, settings on, and the Safe mode switch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="4dp" android:background="@drawable/card_bg" android:orientation="vertical"
    android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="16dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <View android:id="@+id/state_dot" android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginEnd="10dp" android:background="@drawable/dot_accent" />
        <TextView android:id="@+id/state" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="20sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/on_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/badge_bg" android:paddingStart="10dp" android:paddingTop="4dp"
            android:paddingEnd="10dp" android:paddingBottom="4dp" android:textColor="@color/accent"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/state_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:textColor="@color/text_dim" android:textSize="13.5sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp"
        android:background="@color/outline" />
    <LinearLayout android:id="@+id/safe_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground" android:gravity="center_vertical"
        android:minHeight="64dp" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="14dp"
            android:src="@drawable/ic_shield" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Safe mode" android:textColor="@color/text" android:textSize="16sp" />
            <TextView android:id="@+id/safe_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Pauses every tweak, keeps your settings" android:textColor="@color/text_dim" android:textSize="12.5sp" />
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/safe_switch"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
