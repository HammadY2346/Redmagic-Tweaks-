<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="4dp" android:background="@drawable/card_bg" android:gravity="center_horizontal"
    android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="14dp" android:paddingEnd="12dp" android:paddingBottom="12dp">
    <ImageView android:id="@+id/preview" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:adjustViewBounds="true" android:contentDescription="Preview" />
    <TextView android:id="@+id/preview_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_dim" android:textSize="12.5sp" />
</LinearLayout>
